# codeX Discord bot only (not the Next.js site)
FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    fontconfig \
    fonts-dejavu-core \
    fonts-noto-core \
    fonts-hosny-amiri \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY scripts ./scripts
COPY public/discord ./public/discord
COPY public/fonts ./public/fonts
COPY public/guard ./public/guard
COPY discord ./discord

ENV NODE_ENV=production
ENV PORT=8787
EXPOSE 8787

CMD ["node", "scripts/codex-delivery-bot.mjs"]
